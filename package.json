    "postmessage-duplex": "^1.2.0",
    "pptxgenjs": "^4.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "roughjs": "^4.6.6",
    "rxjs": "~7.8.0",
    "slate": "^0.116.0",
    "slate-dom": "^0.116.0",
    "slate-history": "^0.115.0",
    "slate-react": "^0.116.0",
    "tdesign-icons-react": "^0.6.1",
    "tdesign-react": "^1.14.5",
    "tslib": "^2.3.0",
    "viewerjs": "^1.11.7",
    "web-vitals": "^5.1.0",
    "winbox": "^0.2.82",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
